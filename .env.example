# Copy to .env and fill in. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# SQLite for now. Swap for postgresql+psycopg://user:pass@host/db when you Dockerize.
DATABASE_URL=sqlite:///./supportiq.db

# Set to false to skip the vector store (faster startup, no response drafting)
ENABLE_RAG=true
